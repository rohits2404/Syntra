// This is your Prisma schema file.
// Learn more: https://www.prisma.io/docs/orm/v7/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "vercel-edge"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  // Authentication
  authProvider      String?
  githubAccessToken String?
  githubUsername    String?

  // Stripe / Subscription
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  plan       Plan       @default(free)
  planStatus PlanStatus @default(none)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  projects    Project[]
  usageEvents UsageEvent[]
}

enum Plan {
  free
  premium
}

enum PlanStatus {
  none
  active
  past_due
  canceled
}

model UsageEvent {
  id        String   @id @default(uuid())
  userId    String
  type      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

model Account {
  id                String @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ProjectSource {
  github
  upload
}

enum ProjectStatus {
  queued
  processing
  completed
  failed
}

model Project {
  id              String        @id @default(uuid())
  userId          String
  name            String
  source          ProjectSource
  repositoryUrl   String?
  framework       String?
  status          ProjectStatus @default(queued)
  errorMessage    String?
  fileCount       Int           @default(0)
  progressStep    String?
  progressPercent Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  chunks CodeChunk[]
  report Report?

  @@index([userId])
  @@index([userId, status])
}

model CodeChunk {
  id        String @id @default(uuid())
  projectId String
  filePath  String
  content   String @db.Text
  startLine Int?
  endLine   Int?

  // pgvector
  embedding Unsupported("vector(384)")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Report {
  id             String   @id @default(uuid())
  projectId      String   @unique
  healthScore    Int
  categoryScores Json
  issues         Json
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
